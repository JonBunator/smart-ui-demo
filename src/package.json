{
  "name": "smart-ui-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.development -- next dev",
    "prisma-studio": "dotenv -e .env.development -- npx prisma studio",
    "prisma-init": "dotenv -e .env.development -- npx prisma generate",
    "init-db": "dotenv -e .env.development -- npx prisma migrate dev --name init",
    "seed": "dotenv -e .env.development -- npx prisma db seed",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.9.1",
    "@emotion/cache": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.0",
    "@fluentui/react-components": "^9.63.0",
    "@fluentui/react-icons": "^2.0.300",
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "^7.1.0",
    "@mui/material-nextjs": "^7.1.0",
    "@prisma/client": "^6.8.2",
    "fluentui-next-appdir-directive": "^0.2.0",
    "jose": "^6.0.11",
    "next": "15.3.2",
    "openai": "^4.98.0",
    "pg": "^8.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.88.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5"
  }
}
