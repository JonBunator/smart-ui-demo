{
  "name": "smart-ui-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.development -- next dev",
    "prisma-studio": "dotenv -e .env.development -- npx prisma studio",
    "prisma-init": "dotenv -e .env.development -- npx prisma generate",
    "prisma-format": "dotenv -e .env.development -- npx prisma format",
    "init-db": "dotenv -e .env.development -- npx prisma migrate dev --name init",
    "seed": "dotenv -e .env.development -- npx prisma db seed",
    "create-fake-data": "tsx scripts/fakeData/createFakeData.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "prisma": {
    "seed": "tsx prisma/seed/seed.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.11.1",
    "@emotion/cache": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@fluentui/react-components": "^9.68.3",
    "@fluentui/react-icons": "^2.0.307",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@mui/material-nextjs": "^7.3.0",
    "@mui/x-data-grid": "^8.9.2",
    "@prisma/client": "^6.13.0",
    "@xstate/react": "^6.0.0",
    "fluentui-next-appdir-directive": "^0.2.0",
    "jose": "^6.0.12",
    "next": "15.4.6",
    "openai": "^5.12.1",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-confetti": "^6.4.0",
    "react-day-picker": "^9.8.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "sass": "^1.90.0",
    "use-sound": "^5.0.0",
    "xstate": "^5.20.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@faker-js/faker": "^9.9.0",
    "@types/node": "^24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "prisma": "^6.13.0",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
}
