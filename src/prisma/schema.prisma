// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * Survey type
 * 0: No Agent -> Agent -> Proactive Agent (With complete fill)
 * 1: No Agent -> Proactive Agent -> Agent (With section fill)
 * 2: No Agent -> Agent -> Proactive Agent (With section fill)
 * 3: No Agent -> Proactive Agent -> Agent (With complete fill)
 */

/**
 * dataSetOrder can be 0 - 5, specifies the order the datasets are assigned
 * 0: A -> B -> C
 * 1: A -> C -> B
 * 2: B -> C -> A
 * 3: B -> A -> C
 * 4: C -> A -> B
 * 5: C -> B -> A
 */
model Survey {
  id               Int @id @default(autoincrement())
  nextSurveyType   Int @default(0)
  nextDataSetOrder Int @default(0)
}

model SurveyGroup {
  id                     Int             @id @default(autoincrement())
  active                 Boolean         @default(true)
  invitationCode         String          @unique
  Participations         Participation[]
  surveyCompletedMessage String?
}

enum DataType {
  Booking
  Property
  Maintenance
}

enum DataCategory {
  /**
   * Data that is used in survey.
   */
  GroundTruth
  /**
   * Data was added by user.
   */
  UserAdded
}

model Data {
  id                           Int                 @id @default(autoincrement())
  timestamp                    DateTime            @default(now())
  order                        Int? // should be set when category = GroundTruth, order the mails are sent at
  dataSet                      Int? // should be set when category = GroundTruth, values of 0-2
  category                     DataCategory
  type                         DataType
  EMail                        EMail?
  userDataParticipationData    ParticipationData[] @relation("UserDataToParticipationData")
  groundTruthParticipationData ParticipationData[] @relation("GroundTruthToParticipationData")
  // Different data types
  Booking                      Booking?
  Property                     Property?
  Maintenance                  Maintenance?
}

model Booking {
  id           Int      @id @default(autoincrement())
  dataId       Int      @unique
  data         Data     @relation(fields: [dataId], references: [id], onDelete: Cascade)
  name         String
  surname      String
  phoneNumber  String
  eMail        String
  street       String
  houseNumber  String
  city         String
  postalCode   String
  country      String
  bookingStart DateTime
  bookingEnd   DateTime
  numAdults    Int
  numChildren  Int
  property     String
}

model Property {
  id             Int      @id @default(autoincrement())
  dataId         Int      @unique
  data           Data     @relation(fields: [dataId], references: [id], onDelete: Cascade)
  name           String
  description    String
  street         String
  houseNumber    String
  city           String
  postalCode     String
  country        String
  type           String
  numBeds        Int
  numBathrooms   Int
  area           Float
  pricePerNight  Float
  additionalInfo String[]
}

model Maintenance {
  id          Int    @id @default(autoincrement())
  dataId      Int    @unique
  data        Data   @relation(fields: [dataId], references: [id], onDelete: Cascade)
  name        String
  surname     String
  property    String
  category    String
  eMail       String
  urgency     String
  description String
  location    String
}

model EMail {
  id          Int    @id @default(autoincrement())
  author      String
  authorEmail String
  subject     String
  content     String
  dataId      Int    @unique
  Data        Data   @relation(fields: [dataId], references: [id], onDelete: Cascade)
}

model Participation {
  id                          String              @id @default(uuid())
  timestamp                   DateTime            @default(now())
  state                       String?
  surveyState                 String?
  completionTimestamp         DateTime?
  surveyType                  Int
  dataSetOrder                Int
  promptHistoryAgent          String?
  promptHistoryProactiveAgent String?
  surveyGroupId               Int
  SurveyGroup                 SurveyGroup         @relation(fields: [surveyGroupId], references: [id], onDelete: Cascade)
  ParticipationData           ParticipationData[]
  initialQuestions            InitialQuestions?
  noAgentQuestions            NoAgentQuestions?
  agentQuestions              AgentQuestions[]
}

model ParticipationData {
  id              Int           @id @default(autoincrement())
  timestamp       DateTime      @default(now())
  surveyStep      Int
  participationId String
  Participation   Participation @relation(fields: [participationId], references: [id])
  dataId          Int
  userData        Data          @relation("UserDataToParticipationData", fields: [dataId], references: [id])
  groundTruthId   Int
  groundTruth     Data          @relation("GroundTruthToParticipationData", fields: [groundTruthId], references: [id])
}

// Questions
model InitialQuestions {
  id                       Int           @id @default(autoincrement())
  participationId          String        @unique
  Participation            Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  age                      String
  gender                   String
  chatbotExperience        String
  dataManagementExperience String
  proactivePersonality     Int[]
  machineTrust             Int[]
  technologicalAffinity    Int[]
}

model NoAgentQuestions {
  id               Int           @id @default(autoincrement())
  participationId  String        @unique
  Participation    Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  efficiency       Int[]
  perspicuity      Int[]
  dependability    Int[]
  intuitiveUse     Int[]
  visualAesthetics Int[]
  clarity          Int[]
  optionalRemarks  String?
}

enum AgentQuestionsType {
  AGENT
  PROACTIVE_AGENT
}

model AgentQuestions {
  id                 Int                @id @default(autoincrement())
  participationId    String
  Participation      Participation      @relation(fields: [participationId], references: [id], onDelete: Cascade)
  type               AgentQuestionsType
  efficiency         Int[]
  perspicuity        Int[]
  dependability      Int[]
  intuitiveUse       Int[]
  selfAwareness      Int[]
  explanationQuality Int[]
  satisfaction       Int
  helpfulness        Int
  interpretation     Int
  processing         Int
  monitoringRole     Int
  decisionMakerRole  Int
  activeRole         Int
  agentAssessment    Int[]
  optionalRemarks    String?
}
